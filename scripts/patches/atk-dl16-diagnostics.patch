diff --git a/core/src/json_util.cpp b/core/src/json_util.cpp
index b802d5e..ece2bb5 100644
--- a/core/src/json_util.cpp
+++ b/core/src/json_util.cpp
@@ -34,2 +34,22 @@ std::string json_escape(const std::string& input) {
 
+static std::string diagnostic_json(const CaptureDiagnostics& d) {
+    std::ostringstream s;
+    s << "{\"schema\":\"dl16-rx-diagnostics/v1\",\"enabled\":" << (d.enabled ? "true" : "false");
+    if (d.enabled) {
+        s << ",\"usb_reads\":" << d.reads << ",\"usb_bytes\":" << d.bytes
+          << ",\"short_reads\":" << d.short_reads << ",\"unaligned_bytes\":" << d.unaligned_bytes
+          << ",\"messages\":" << d.messages << ",\"first_orders\":[";
+        for (size_t i=0;i<d.first_orders.size();++i) { if(i)s<<","; s<<d.first_orders[i]; }
+        s << "]";
+        auto counts = [&](const char* name, const auto& values) {
+            s << ",\"" << name << "\":{"; bool first=true;
+            for(const auto& item:values) { if(!first)s<<","; first=false; s<<"\""<<unsigned(item.first)<<"\":"<<item.second; }
+            s << "}";
+        };
+        counts("order_counts",d.orders); counts("samples_before_crop",d.before_crop);
+        counts("samples_after_crop",d.after_crop); counts("crop_offsets",d.offsets);
+    }
+    s << "}"; return s.str();
+}

--- a/core/include/atkdl16/types.h
+++ b/core/include/atkdl16/types.h
@@ -167,2 +167,23 @@ struct ChannelEdges {
 
+// Bounded observations only; counters never control capture behavior.
+struct CaptureDiagnostics {
+    bool enabled{false};
+    uint64_t reads{0}, bytes{0}, short_reads{0}, unaligned_bytes{0}, messages{0};
+    std::map<unsigned, uint64_t> orders;
+    std::vector<unsigned> first_orders;
+    std::map<uint8_t, uint64_t> before_crop, after_crop, offsets;
+    void observe_read(size_t n) {
+        if (!enabled) return;
+        ++reads; bytes += n;
+        if (n && n < 2048) ++short_reads;
+        unaligned_bytes += n % 2048;
+    }
+    void observe_order(unsigned n) {
+        if (!enabled) return;
+        ++messages;
+        if (n <= 6) ++orders[n];
+        if (first_orders.size() < 32) first_orders.push_back(n);
+    }
+};

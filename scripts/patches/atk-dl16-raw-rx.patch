+// v1: magic DL16RX01, then LE32 length, LE32 ErrorCode, and exact pre-transform bytes.
+inline bool valid_raw_rx_path(const std::string& path) {
+    if(path.empty() || path.find('\0')!=std::string::npos || !std::filesystem::u8path(path).is_absolute()) return false;
+#ifdef _WIN32
+    if(path.rfind("\\\\",0)==0 || path.rfind("//",0)==0 || path.find(':',2)!=std::string::npos) return false;
+#endif
+    return true;
+}
+
+class RawRxWriter {
+    RawRxLog& log; FILE* file{nullptr};
+    size_t (*write_fn)(const void*,size_t,size_t,FILE*);
+    int (*flush_fn)(FILE*);
+    int (*close_fn)(FILE*);
+    bool fail(const char* text) { log.error = text; return false; }
+public:
+    explicit RawRxWriter(RawRxLog& metadata,
+        size_t (*write)(const void*,size_t,size_t,FILE*)=std::fwrite,
+        int (*flush)(FILE*)=std::fflush, int (*finish)(FILE*)=std::fclose)
+        : log(metadata), write_fn(write), flush_fn(flush), close_fn(finish) {}
+    ~RawRxWriter() { close(); }
+    bool open(const std::string& path, uint64_t limit) {
+        if (path.empty()) return true;
+        log.enabled=true; log.path=path; log.max_bytes=limit;
+        if (limit < 8 || limit > 32ULL*1024*1024) return fail("raw RX limit must be 8..33554432 bytes");
+        const auto p=std::filesystem::u8path(path);
+        if (!valid_raw_rx_path(path)) return fail("raw RX path must be an absolute local file");
+#ifdef _WIN32
+        file=_wfopen(p.c_str(), L"wbx");
+#else
+        file=std::fopen(p.c_str(), "wbx");
+#endif
+        if (!file) return fail("cannot exclusively create raw RX log");
+        if (write_fn("DL16RX01",1,8,file)!=8 || flush_fn(file)!=0) return fail("cannot write raw RX header");
+        log.bytes_written=8; return true;
+    }
+    bool append(const uint8_t* data, size_t n, ErrorCode status) {
+        if (!log.enabled) return true;
+        ++log.reads; log.observed_bytes+=n;
+        if (!log.error.empty()) return false;
+        if (log.truncated || n > log.max_bytes-log.bytes_written || n+8 > log.max_bytes-log.bytes_written) {
+            log.truncated=true; return true;
+        }
+        uint8_t header[8]; uint32_t length=static_cast<uint32_t>(n), code=static_cast<uint32_t>(status);
+        for (unsigned i=0;i<4;++i) { header[i]=static_cast<uint8_t>(length>>(8*i)); header[i+4]=static_cast<uint8_t>(code>>(8*i)); }
+        if (write_fn(header,1,8,file)!=8 || (n && write_fn(data,1,n,file)!=n) || flush_fn(file)!=0)
+            return fail("cannot write/flush raw RX record; file prefix may be incomplete");
+        log.bytes_written+=8+n; log.payload_bytes+=n; ++log.records; return true;
+    }
+    bool close() {
+        if (file) { FILE* f=file; file=nullptr; if(close_fn(f)!=0) fail("cannot close raw RX log"); else log.closed=true; }
+        return log.error.empty();
+    }
+};
 

diff --git a/core/include/atkdl16/types.h b/core/include/atkdl16/types.h
index 8de0883..e5939bb 100644
--- a/core/include/atkdl16/types.h
+++ b/core/include/atkdl16/types.h
@@ -167,2 +167,14 @@ struct ChannelEdges {
 
+struct FlushObservation {
+    uint64_t reads{0}, bytes{0}, errors{0};
+    bool ended_empty{false}, limit_reached{false};
+    std::vector<uint64_t> sizes;
+    void observe(size_t n, bool ok) {
+        ++reads; bytes += n; if (!ok) ++errors;
+        if (sizes.size() < 50) sizes.push_back(n);
+        ended_empty = n == 0;
+        limit_reached = reads == 50 && !ended_empty;
+    }
+};
+
 // Bounded observations only; counters never control capture behavior.
@@ -170,2 +182,4 @@ struct CaptureDiagnostics {
     bool enabled{false};
+    bool wake_write_ok{false}, wake_observed{false};
+    FlushObservation wake_flush, explicit_flush;
     uint64_t reads{0}, bytes{0}, short_reads{0}, unaligned_bytes{0}, messages{0};

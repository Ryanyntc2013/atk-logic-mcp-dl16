@@ -119,2 +119,3 @@ struct TriggerConfig {
 struct CaptureConfig {
+    bool experimental_session_lifecycle{false};
     CaptureMode mode{CaptureMode::Buffer};
@@ -202,2 +203,16 @@ struct CaptureDiagnostics {
 
+inline bool experimental_depth_ready(bool ack, bool offset_received, bool complete,
+                                     const std::map<uint8_t, uint64_t>& samples,
+                                     const std::map<uint8_t, uint64_t>& offsets,
+                                     const std::vector<uint8_t>& channels, uint64_t target) {
+    if (!ack || !offset_received || !complete || channels.empty()) return false;
+    for (uint8_t ch : channels) {
+        auto sample = samples.find(ch); auto offset = offsets.find(ch);
+        uint64_t start = offset == offsets.end() ? 0 : offset->second;
+        if (sample == samples.end() || sample->second < start || sample->second - start < target)
+            return false;
+    }
+    return true;
+}
+

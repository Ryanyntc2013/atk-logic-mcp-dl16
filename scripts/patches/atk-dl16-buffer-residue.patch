+namespace atkdl16::cli {
+// Keep this outside every subcommand, including enumeration and session startup.
+template<class Usage, class Dispatch>
+int entry(int argc, char* argv[], Usage usage, Dispatch dispatch) {
+    for (int i = 1; i < argc; ++i) {

@@ -18,6 +18,34 @@
 // len must be an integer multiple of 2048
 void convert_to_device(const void* src, void* dst, size_t len);
 
+// Raw USB transport partitions are independent of 2048-byte FPGA banks.
+class RawBankAccumulator {
+public:
+    void push(const uint8_t* data, size_t length, std::vector<uint8_t>& converted) {
+        if (length) pending_.insert(pending_.end(), data, data + length);
+        const size_t aligned = pending_.size() / USB_BLOCK_SIZE * USB_BLOCK_SIZE;
+        converted.resize(aligned);
+        if (aligned) {
+            convert_to_pc(pending_.data(), converted.data(), aligned);
+            pending_.erase(pending_.begin(), pending_.begin() + aligned);
+        }
+    }
+    size_t pending_bytes() const { return pending_.size(); }
+    // Call on every exit. Residue is raw transport data, never valid samples.
+    void mark_terminal(CaptureResult& result) const {
+        result.raw_bank_residue_bytes = pending_bytes();
+        if (!pending_bytes()) return;
+        result.success = false;
+        result.data_integrity = DataIntegrity::Incomplete;
+        if (result.error_code == ErrorCode::Ok) {
+            result.error_code = ErrorCode::IncompleteCapture;
+            result.error_message = "Capture ended with an incomplete raw USB bank";
+        }
+    }
+private:
+    std::vector<uint8_t> pending_;
+};
+
 // Frequency <-> 1-based hardware code conversion
 uint8_t sample_rate_to_code(uint64_t rate_hz);
 uint64_t code_to_sample_rate(uint8_t code);

 inline bool get_string(const Value& v,const std::string& k,std::string& s){auto p=get(v,k);if(!p||p->kind!=Value::Kind::String)return false;s=p->scalar;return true;}
 inline bool get_integer(const Value& v,const std::string& k,int& n){auto p=get(v,k);if(!p||p->kind!=Value::Kind::Number||p->scalar.find_first_of(".eE")!=std::string::npos)return false;try{size_t u=0;long x=std::stol(p->scalar,&u);if(u!=p->scalar.size()||x<std::numeric_limits<int>::min()||x>std::numeric_limits<int>::max())return false;n=static_cast<int>(x);return true;}catch(...){return false;}}
+inline bool get_number(const Value& v,const std::string& k,double& d){auto p=get(v,k);if(!p||p->kind!=Value::Kind::Number)return false;try{size_t u=0;d=std::stod(p->scalar,&u);return u==p->scalar.size()&&std::isfinite(d);}catch(...){return false;}}
+inline bool build_pwm_payload(const std::string& op, int output_ch, int freq_hz, double duty_pct, std::vector<uint8_t>& out, std::string& err) {
+    if(output_ch != 0 && output_ch != 1){ err = "output must be 0 or 1"; return false; }
+    if(op == "configure") {
+        if(freq_hz < 1 || freq_hz > 20000000){ err = "frequency_hz must be in [1, 20000000]"; return false; }
+        if(!std::isfinite(duty_pct) || duty_pct < 0.0 || duty_pct > 100.0){ err = "duty_percent must be finite in [0, 100]"; return false; }
+        constexpr uint64_t PWM_COUNTER_HZ = 200000000ULL;
+        uint32_t period = static_cast<uint32_t>(std::floor(PWM_COUNTER_HZ / static_cast<double>(freq_hz) + 0.5));
+        uint32_t dcount = static_cast<uint32_t>(std::floor(period * duty_pct / 100.0 + 0.5));
+        out.clear();
+        out.push_back(static_cast<uint8_t>((output_ch << 4) + 0x11));
+        for(int i=0; i<4; ++i) out.push_back(static_cast<uint8_t>((period >> (8*i)) & 0xFF));
+        for(int i=0; i<4; ++i) out.push_back(static_cast<uint8_t>((dcount >> (8*i)) & 0xFF));
+        return true;
+    } else if(op == "stop") {
+        out.clear();
+        out.push_back(static_cast<uint8_t>((output_ch + 1) << 4));
+        return true;
+    }
+    err = "unknown op: " + op;
+    return false;
+}
 inline std::string response(const std::string& id,const std::string& fields){return "{\"request_id\":\""+json_escape(id)+"\","+fields+"}\n";}
 inline std::string error_response(const std::string& id,const std::string& code,const std::string& message){return response(id,"\"ok\":false,\"error_code\":\""+json_escape(code)+"\",\"message\":\""+json_escape(message)+"\"");}

+static bool session_number(const session::Value& v,const std::string& key,double& out){auto p=session::get(v,key);if(!p||p->kind!=session::Value::Kind::Number)return false;try{size_t n=0;out=std::stod(p->scalar,&n);return n==p->scalar.size()&&std::isfinite(out);}catch(...){return false;}}
+static bool session_channels(const session::Value& v,std::vector<uint8_t>& out){auto p=session::get(v,"channels");if(!p||p->kind!=session::Value::Kind::Array||p->array.empty()||p->array.size()>16)return false;for(const auto& x:p->array){if(x.kind!=session::Value::Kind::Number||x.scalar.find_first_of(".eE")!=std::string::npos)return false;try{size_t n=0;long ch=std::stol(x.scalar,&n);if(n!=x.scalar.size()||ch<0||ch>15)return false;auto c=static_cast<uint8_t>(ch);if(std::find(out.begin(),out.end(),c)!=out.end())return false;out.push_back(c);}catch(...){return false;}}return true;}
+static bool valid_session_trigger(const std::string& spec){
+    if(spec.empty()||spec=="immediate"||spec=="none")return true;
+    size_t start=0;while(start<spec.size()){size_t comma=spec.find(',',start);std::string part=spec.substr(start,comma==std::string::npos?std::string::npos:comma-start);if(part.empty())return false;if(part.rfind("ch",0)==0)part=part.substr(2);auto colon=part.find(':');if(colon==std::string::npos)return false;try{size_t used=0;int ch=std::stoi(part.substr(0,colon),&used);if(used!=colon||ch<0||ch>15)return false;}catch(...){return false;}auto edge=part.substr(colon+1);if(edge!="rising"&&edge!="falling"&&edge!="high"&&edge!="low"&&edge!="both"&&edge!="double")return false;start=comma==std::string::npos?spec.size():comma+1;}return true;
+}

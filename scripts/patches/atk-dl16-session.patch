+    if(!p.parse(v,e)) std::cerr << "session parser error: " << e << std::endl;
+    ASSERT_TRUE(e.empty()); std::string id,label; int n=0;
+    ASSERT_TRUE(session::get_string(v,"request_id",id)); ASSERT_TRUE(session::get_string(v,"label",label)); ASSERT_TRUE(session::get_integer(v,"n",n));

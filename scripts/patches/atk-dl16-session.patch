+}
+TEST_CASE(test_session_json_parser_rejects_duplicates_and_trailing_bytes) {
+    session::Value v;std::string e;session::Parser d("{\"x\":1,\"x\":2}");ASSERT_FALSE(d.parse(v,e));ASSERT_TRUE(e.find("duplicate")!=std::string::npos);
+    e.clear();session::Parser t("{\"x\":1} tail");ASSERT_FALSE(t.parse(v,e));ASSERT_FALSE(e.empty());
+}
+TEST_CASE(test_session_json_parser_rejects_invalid_surrogate_and_non_object) {

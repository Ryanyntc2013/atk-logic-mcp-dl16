+        if(const auto* t=session::get(req,"trigger")){if(t->kind!=session::Value::Kind::String){std::cout<<session::error_response(id,"INVALID_CAPTURE","trigger must be a string")<<std::flush;continue;}trigger=t->scalar;}
+        if(session::get(req,"trigger_position_percent")&&!session_number(req,"trigger_position_percent",position)){std::cout<<session::error_response(id,"INVALID_CAPTURE","trigger_position_percent must be numeric")<<std::flush;continue;}
